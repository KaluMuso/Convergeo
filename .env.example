SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_BYPASS=
# Client API + media base. NEXT_PUBLIC_* are inlined at BUILD time, so set these
# before building apps/customer and REBUILD after changing them. If API base is
# blank in prod, browser cart/wishlist calls fail closed to same-origin (404);
# if the Cloudinary cloud name is blank, product/category/hero images render blank.
# Deployment plane is required. Do not infer "local" from a missing value.
# Local: development. Vercel Production: production. Staging/Preview: staging or preview.
NEXT_PUBLIC_DEPLOYMENT_PLANE=development
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Seasonal brand re-skin (docs/designs/SELECTION.md §8). One of: slate (default),
# harvest, mauve, evergreen. Blank/invalid ⇒ slate. Read by BOTH customer (applies
# the palette) and admin (Theme presets console); inlined at build, so REBUILD to
# switch seasons. See the admin Theme presets page for a live preview of each.
NEXT_PUBLIC_SEASONAL_THEME=
# Google OAuth is fail-closed in the UI. Do not set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED
# to true until the Supabase Google provider is enabled and verified.
# See docs/ops/auth-providers.md (names only — never commit secret values).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
# Phone OTP is off during the cash-on-delivery pilot, so sign-in/sign-up default to the
# email tab. Set to "true" once SMS OTP is live to make phone the default tab again.
NEXT_PUBLIC_PHONE_OTP_ENABLED=
# Public social profile URLs for the customer top bar. Empty = icon hidden (no generic
# facebook.com / x.com / instagram.com fallbacks). Must be https profile URLs.
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_TWITTER_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
LENCO_API_TOKEN=
LENCO_BASE_URL=
OPENROUTER_API_KEY=
# Ask Vergeo models (OpenRouter ids). Defaults: moonshotai/kimi-k2 + google/gemini-2.0-flash-lite-001.
# Empty = default; set ASK_FALLBACK_MODEL=none to disable the fallback model.
ASK_MODEL=
ASK_FALLBACK_MODEL=
# Optional: comma-separated hosts allowed in AI answer links (default vergeo5.com,convergeo.com)
ASK_ALLOWED_LINK_HOSTS=
WHATSAPP_TOKEN=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
# sandbox | live — required by send-sms-otp edge function. Staging must use sandbox.
AT_ENVIRONMENT=
SEND_SMS_HOOK_SECRET=
RESEND_API_KEY=
CLOUDINARY_URL=
# T8 social contacts — server pepper for phone discovery (set in prod/staging; never commit).
SOCIAL_PHONE_PEPPER=
