{
  "name": "vergeo5",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --config packages/config/prettier.config.mjs --write .",
    "format:check": "prettier --config packages/config/prettier.config.mjs --check .",
    "verify-scaffold": "node scripts/verify-scaffold.mjs",
    "prepare": "lefthook install || true",
    "release-certify": "bash scripts/qa/release-certify.sh --mode ci",
    "release-certify:local": "bash scripts/qa/release-certify.sh --mode local-development",
    "release-certify:static": "bash scripts/qa/release-certify.sh --mode ci --layer static --skip-e2e --skip-rls",
    "release-certify:self-test": "node --test scripts/qa/self-test/*.test.mjs",
    "perf:lighthouse": "node scripts/ci/lighthouse-runner.mjs",
    "perf:lighthouse:test": "node --test scripts/ci/lighthouse-runner.test.mjs scripts/ci/perf-content-readiness.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "lefthook": "^1.11.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "puppeteer": "25.13.0",
    "yauzl": "3.4.0"
  },
  "lint-staged": {
    "*": "prettier --config packages/config/prettier.config.mjs --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "@eslint/config-array>minimatch": "10.2.5",
      "@eslint/eslintrc>minimatch": "10.2.5",
      "eslint>minimatch": "10.2.5",
      "minimatch@10.2.5>brace-expansion": "5.0.12",
      "minimatch@10.2.6>brace-expansion": "5.0.12",
      "minimatch@3.1.5>brace-expansion": "1.1.21",
      "fast-uri": "3.1.8",
      "ip-address": "10.7.3",
      "nanoid@^3.0.0": "3.3.18",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "sharp@<0.35.5": "0.35.5",
      "browserslist": "4.28.8",
      "next": "15.5.27",
      "source-map-js": "1.2.2",
      "proxy-addr": "2.0.8",
      "compression": "1.8.2"
    }
  }
}
