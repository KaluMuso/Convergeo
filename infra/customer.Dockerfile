# syntax=docker/dockerfile:1

# Multi-stage customer app image (build context: repo root).
# NEXT_PUBLIC_* values are build-time ARGs — they are baked into the client bundle.

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS pruner
WORKDIR /app
COPY . .
RUN corepack prepare pnpm@9.15.4 --activate \
  && pnpm dlx turbo@2.11.11 prune customer --docker \
  && cp tsconfig.base.json out/full/tsconfig.base.json

FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN corepack prepare pnpm@9.15.4 --activate \
  && pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .

ARG GIT_SHA=unknown
ARG NEXT_PUBLIC_ADMIN_BYPASS
ARG NEXT_PUBLIC_ANALYTICS_ENDPOINT
ARG NEXT_PUBLIC_ANALYTICS_V2_TRACKING
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_CI_PERF_HARNESS
ARG NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
ARG NEXT_PUBLIC_DEPLOYMENT_PLANE
ARG NEXT_PUBLIC_E2E_MOCK_SESSION
ARG NEXT_PUBLIC_ENABLE_UI_PREVIEW
ARG NEXT_PUBLIC_GA4_MEASUREMENT_ID
ARG NEXT_PUBLIC_GOOGLE_AUTH_ENABLED
ARG NEXT_PUBLIC_LENCO_PUBLIC_KEY
ARG NEXT_PUBLIC_PHONE_OTP_ENABLED
ARG NEXT_PUBLIC_SEASONAL_THEME
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT
ARG NEXT_PUBLIC_SENTRY_RELEASE
ARG NEXT_PUBLIC_SHOW_SAMPLE_LISTINGS
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SOCIAL_FACEBOOK_URL
ARG NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL
ARG NEXT_PUBLIC_SOCIAL_TWITTER_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPPORT_EMAIL
ARG NEXT_PUBLIC_SUPPORT_WHATSAPP
ARG NEXT_PUBLIC_VENDOR_APP_URL
ARG NEXT_PUBLIC_VERGEO_API_URL
ARG NEXT_PUBLIC_VERGEO_BUILD_ID
ARG NEXT_PUBLIC_VERGEO_ENV

ENV GIT_SHA=${GIT_SHA} \
    NEXT_PUBLIC_ADMIN_BYPASS=${NEXT_PUBLIC_ADMIN_BYPASS} \
    NEXT_PUBLIC_ANALYTICS_ENDPOINT=${NEXT_PUBLIC_ANALYTICS_ENDPOINT} \
    NEXT_PUBLIC_ANALYTICS_V2_TRACKING=${NEXT_PUBLIC_ANALYTICS_V2_TRACKING} \
    NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_CI_PERF_HARNESS=${NEXT_PUBLIC_CI_PERF_HARNESS} \
    NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=${NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME} \
    NEXT_PUBLIC_DEPLOYMENT_PLANE=${NEXT_PUBLIC_DEPLOYMENT_PLANE} \
    NEXT_PUBLIC_E2E_MOCK_SESSION=${NEXT_PUBLIC_E2E_MOCK_SESSION} \
    NEXT_PUBLIC_ENABLE_UI_PREVIEW=${NEXT_PUBLIC_ENABLE_UI_PREVIEW} \
    NEXT_PUBLIC_GA4_MEASUREMENT_ID=${NEXT_PUBLIC_GA4_MEASUREMENT_ID} \
    NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=${NEXT_PUBLIC_GOOGLE_AUTH_ENABLED} \
    NEXT_PUBLIC_LENCO_PUBLIC_KEY=${NEXT_PUBLIC_LENCO_PUBLIC_KEY} \
    NEXT_PUBLIC_PHONE_OTP_ENABLED=${NEXT_PUBLIC_PHONE_OTP_ENABLED} \
    NEXT_PUBLIC_SEASONAL_THEME=${NEXT_PUBLIC_SEASONAL_THEME} \
    NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN} \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=${NEXT_PUBLIC_SENTRY_ENVIRONMENT} \
    NEXT_PUBLIC_SENTRY_RELEASE=${NEXT_PUBLIC_SENTRY_RELEASE} \
    NEXT_PUBLIC_SHOW_SAMPLE_LISTINGS=${NEXT_PUBLIC_SHOW_SAMPLE_LISTINGS} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=${NEXT_PUBLIC_SOCIAL_FACEBOOK_URL} \
    NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=${NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL} \
    NEXT_PUBLIC_SOCIAL_TWITTER_URL=${NEXT_PUBLIC_SOCIAL_TWITTER_URL} \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY} \
    NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL} \
    NEXT_PUBLIC_SUPPORT_EMAIL=${NEXT_PUBLIC_SUPPORT_EMAIL} \
    NEXT_PUBLIC_SUPPORT_WHATSAPP=${NEXT_PUBLIC_SUPPORT_WHATSAPP} \
    NEXT_PUBLIC_VENDOR_APP_URL=${NEXT_PUBLIC_VENDOR_APP_URL} \
    NEXT_PUBLIC_VERGEO_API_URL=${NEXT_PUBLIC_VERGEO_API_URL} \
    NEXT_PUBLIC_VERGEO_BUILD_ID=${NEXT_PUBLIC_VERGEO_BUILD_ID} \
    NEXT_PUBLIC_VERGEO_ENV=${NEXT_PUBLIC_VERGEO_ENV} \
    NODE_ENV=production

RUN pnpm turbo run build --filter=customer

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${GIT_SHA}"

COPY --from=builder /app/apps/customer/public ./apps/customer/public
COPY --from=builder --chown=node:node /app/apps/customer/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/customer/.next/static ./apps/customer/.next/static

USER node
EXPOSE 3000
CMD ["node", "apps/customer/server.js"]