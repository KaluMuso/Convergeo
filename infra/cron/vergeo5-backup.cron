# Install as /etc/cron.d/vergeo5-backup on the Hetzner API host (root-owned, mode 0644).
# Twice-daily encrypted production backup to R2, plus a weekly copy.
# No decryption key lives on this host (founder decision, 28 Nov). The restore drill
# (infra/scripts/db-restore-drill-r2.sh) is NOT scheduled here; it moves to the staging box once it exists.
CRON_TZ=Africa/Lusaka
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
0 2,14 * * * root /usr/local/bin/vergeo5-db-backup daily >> /var/log/vergeo5-backup.log 2>&1
30 3 * * 0 root /usr/local/bin/vergeo5-db-backup weekly >> /var/log/vergeo5-backup.log 2>&1
