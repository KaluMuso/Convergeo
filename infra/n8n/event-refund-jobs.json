    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const src = ($input.first() && $input.first().json) || {};\nconst dead = Number(src.dead || 0);\nconst manualReview = Number(src.manual_review || 0);\nif (!Number.isFinite(dead) || dead < 0) {\n  throw new Error('Event refund jobs tick returned invalid dead counter');\n}\nif (!Number.isFinite(manualReview) || manualReview < 0) {\n  throw new Error('Event refund jobs tick returned invalid manual_review counter');\n}\nif (dead > 0) {\n  throw new Error(`Event refund jobs dead-lettered ${dead} item(s)`);\n}\nif (manualReview > 0) {\n  throw new Error(`Event refund jobs need manual review for ${manualReview} item(s)`);\n}\nreturn $input.all();"
      },
      "id": "assert-refund-jobs-healthy",
      "name": "Assert Refund Jobs Healthy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 300]
    }
