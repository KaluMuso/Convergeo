      "typeVersion": 4.2,
      "position": [520, 300],
      "retryOnFail": false,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Vergeo5 Internal Event Advance Debts"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const src = ($input.first() && $input.first().json) || {};\nconst flagged = Number(src.debts_flagged);\nconst suspended = Number(src.vendors_suspended);\nif (!Number.isInteger(flagged) || flagged < 0) {\n  throw new Error('Advance debts tick returned invalid debts_flagged counter');\n}\nif (!Number.isInteger(suspended) || suspended < 0 || suspended > flagged) {\n  throw new Error('Advance debts tick returned invalid vendors_suspended counter');\n}\nif (flagged > 0) {\n  throw new Error(`Advance debts overdue: ${flagged} debt(s) blacklisted, ${suspended} organiser(s) suspended; legal follow-up flagged`);\n}\nreturn $input.all();"
      },
      "id": "assert-advance-debts-outcome",
      "name": "Alert On Overdue Advance Debts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 300]
    }
  ],
