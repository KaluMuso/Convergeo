# Vergeo5 OCI runtime — names only. Copy to infra/.env and fill locally.
# Never commit infra/.env.

# --- API (FastAPI) ---
# Prebuilt image tag pulled from GHCR (built by api-image.yml). Defaults to :latest;
# set to a git SHA to pin a specific build for reproducible deploy / rollback.
API_IMAGE_TAG=latest
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Direct/session Postgres DSN for server-side SQL (ledger, reconciliation, escrow,
# hybrid-search RRF, every /internal/* cron tick).
# ⚠ LOAD-BEARING — DO NOT LEAVE BLANK. Unset ⇒ the API silently falls back to the
#   local dev DSN (127.0.0.1:54322), so on a real host every direct-DB call hangs to
#   the 10s pool timeout → 500 "couldn't get a connection". Symptoms: /search
#   degraded=true and all /internal/* ticks + checkout/escrow fail. (SUPABASE_URL
#   above is the REST endpoint and is NOT a substitute.)
# Use the Supabase SESSION pooler (port 5432), NOT the transaction pooler (6543):
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
ENV=
LOG_LEVEL=
CORS_ORIGINS=

# --- Observability (Sentry) ---
# API DSN (server-only). No-op when unset. Never commit a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Immutable git SHA for release tagging (prefer GIT_SHA / image tag).
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Source-map upload (deploy host only — never expose to browsers).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Protected POST /internal/sentry-test — required token; disabled in production
# unless ENABLE_SENTRY_TEST_ENDPOINT=true.
INTERNAL_SENTRY_TEST_TOKEN=
ENABLE_SENTRY_TEST_ENDPOINT=

# --- Payments: Lenco ---
# Secret API token (Bearer; issued/rotated via Lenco support — treat as a password).
# Rotating this also re-keys webhook verification (signing key = sha256(token)).
LENCO_API_TOKEN=
# sandbox | production. Defaults to production when unset.
LENCO_ENV=
# Optional: override only if Lenco's sandbox REST base differs from the built-in default.
LENCO_SANDBOX_BASE_URL=
# Merchant account id — used by payouts/reconciliation (resolved from /accounts if unset).
LENCO_ACCOUNT_ID=
# Optional: 1/true to enable Zamtel USSD collections (gated pending F9a).
LENCO_ENABLE_ZAMTEL_COLLECTIONS=

# --- Money movement kill switches (safe defaults) ---
# Collections and payouts remain disabled until their separate founder gates clear.
PAYMENTS_ENABLED=false
PAYMENTS_ALLOW_PRODUCTION=false
PAYOUTS_ENABLED=false
# Read only when ENV=staging. Set true temporarily for an approved sandbox drill,
# then restore false immediately after evidence capture.
STAGING_ALLOW_PAYOUTS=false

# --- Notifications: WhatsApp Cloud API (Lane 1 — the ONLY customer channel) ---
# D15: official Meta Cloud API only for every customer-facing / transactional
# message. WAHA is forbidden here and always will be. See the Lane 2 block below
# for the one narrow, inbound-only exception (D35).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional: Graph API version (has a built-in default).
WHATSAPP_API_VERSION=

# --- WAHA vendor intake (Lane 2, D35 — DEFAULT OFF, names only) ---
# Isolated, flag-gated (`waha_vendor_intake`, default false), STRICTLY
# INBOUND-ONLY verified-vendor product-intake lane. It never messages a
# customer, never sends an acknowledgement or any other outbound message,
# never touches OTP/payment/support/moderation, and never accepts groups.
#
# These are DISTINCT from WHATSAPP_* (Lane 1) and LENCO_* and rotate on their
# own schedule — rotating one must never re-key the others. Values live only in
# the isolated host's secret store; never commit one.
#
# Internal URL of the isolated WAHA instance (host/routing, not a secret).
WAHA_INTAKE_BASE_URL=
# Bearer/API key the backend presents to the WAHA API.
WAHA_INTAKE_API_KEY=
# WAHA session name bound to the dedicated intake number.
WAHA_INTAKE_SESSION=
# Shared secret for the inbound HMAC-SHA-512 signature (`openssl rand -hex 32`).
# WAHA 2026.5.1 signs the raw body into X-Webhook-Hmac with
# X-Webhook-Hmac-Algorithm: sha512 — NOT Meta's X-Hub-Signature-256 scheme.
WAHA_INTAKE_WEBHOOK_SECRET=
# Space-separated CIDR allowlist for the intake route's Caddy remote_ip matcher.
WAHA_INTAKE_ALLOWED_IPS=
# The dedicated +260 intake number. NB-7: this MUST differ from the Cloud API
# sender AND from any waha.vergeo.company / ZedApply / agency WAHA sender.
WAHA_INTAKE_SENDER_E164=

# --- Notifications: SMS fallback (Africa's Talking) ---
# Use LIVE credentials — the adapter targets AT's production messaging endpoint.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# --- Notifications: Email fallback (Resend) ---
RESEND_API_KEY=
# Optional: from-address (defaults to notifications@vergeo5.com).
RESEND_FROM_EMAIL=

# --- Internal cron tokens (shared secrets sent as X-Internal-Token) ---
# Generate each with `openssl rand -hex 32`. Never ship the insecure dev defaults.
INTERNAL_RECONCILIATION_TOKEN=
INTERNAL_PAYMENT_SWEEPER_TOKEN=
INTERNAL_N8N_TOKEN=
INTERNAL_DISPATCH_TOKEN=
INTERNAL_DIGEST_TOKEN=
INTERNAL_EMBEDDINGS_TOKEN=
INTERNAL_EVENT_RELEASE_TOKEN=
INTERNAL_FUNNEL_TOKEN=
INTERNAL_INTAKE_TOKEN=
INTERNAL_JOB_COMPLETION_TOKEN=
INTERNAL_ORDER_JOBS_TOKEN=
INTERNAL_PAYOUTS_TOKEN=
INTERNAL_RELEASE_JOB_TOKEN=
INTERNAL_REVIEW_AGGREGATE_TOKEN=
INTERNAL_STOCK_SWEEPER_TOKEN=
INTERNAL_SWEEPERS_TOKEN=
INTERNAL_TICKETS_ISSUE_TOKEN=

# --- Ops alerts ---
# E.164 WhatsApp number for founder alerts (payout failures, reconciliation).
FOUNDER_WHATSAPP_E164=

# --- Caddy / host routing ---
API_DOMAIN=api.vergeo5.com
VENDOR_DOMAIN=vendor.vergeo5.com
ADMIN_DOMAIN=admin.vergeo5.com
N8N_DOMAIN=n8n.vergeo5.com
VENDOR_UPSTREAM=host.docker.internal:3001
ADMIN_UPSTREAM=host.docker.internal:3002
# Space-separated CIDRs for Caddy remote_ip matcher (set at deploy).
# MUST be quoted when the file is ever `source`d in bash (slashes/spaces break unquoted values).
ADMIN_ALLOWED_IPS="127.0.0.1/32 10.0.0.0/8"

# --- n8n ---
# Base URL used by imported workflow HTTP nodes (for example https://api.vergeo5.com).
API_URL=
N8N_WEBHOOK_URL=
N8N_HOST=
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
WEBHOOK_URL=
# Upstash Redis REST (OTP per-number rate limit: 3 requests / 15 min).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shared secret for UptimeRobot → n8n uptime-alert webhook (header X-Uptime-Secret).
UPTIME_WEBHOOK_SECRET=

# --- TLS / ACME (optional overrides) ---
ACME_EMAIL=
