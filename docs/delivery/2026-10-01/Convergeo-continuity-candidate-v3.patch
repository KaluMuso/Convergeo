+)
+
+REQUEST = {
+    "operation_id": "aaaaaaaa-1234-1234-1234-aaaaaaaaaaaa",
+    "location_id": "bbbbbbbb-1234-1234-1234-bbbbbbbbbbbb",
+    "delta": -1,
+    "reason": "damaged unit",
