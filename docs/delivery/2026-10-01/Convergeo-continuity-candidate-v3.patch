+            "status": "processing",
+            "merchant_reference": "pay-pending",
+            "provider_reference": None,
+            "provider_status": None,
+        },
+    )
+    assert evidence.terminal_transfers == ()
+    assert evidence.unresolved == ()
+    assert len(evidence.source_sha256) == 64
+
